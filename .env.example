# CivicLens — Environment Variables
# Copy this file to .env for local development (never commit .env).
# In production, set these in the Vercel Project Dashboard → Settings → Environment Variables.

# Base URL of the CivicLens analysis backend (FastAPI / Gemini proxy).
# Local fallback is http://127.0.0.1:8000 when unset.
VITE_API_URL=http://127.0.0.1:8000